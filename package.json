{
  "name": "turndiff",
  "version": "0.1.0",
  "description": "Review git-spice stacks, commits and agent turns in the browser, and send line comments back to the agent.",
  "type": "module",
  "bin": {
    "turndiff": "./bin/turndiff"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "e2e": "bun scripts/e2e.ts",
    "scenario": "bun scripts/scenario.ts",
    "check": "bun run typecheck && bun test",
    "build": "bun -e 'await import(\"./src/server/assets.ts\").then(m => m.ensureUiBuilt({force: true}))'"
  },
  "dependencies": {
    "@pierre/diffs": "^1.4.2",
    "marked": "^18.0.14",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.8.0"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.10"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ]
}
